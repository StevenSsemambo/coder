{
  "name": "saymacoder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SayMaCoder - offline-first coding and tech-learning toolkit for phones",
  "scripts": {
    "postinstall": "node scripts/prepare-runtimes.mjs",
    "dev": "vite",
    "build": "node scripts/prepare-runtimes.mjs && vite build",
    "postbuild": "node scripts/fetch-cpp-compiler.mjs",
    "preview": "vite preview --host",
    "test": "node scripts/prepare-runtimes.mjs && node tests/run.mjs && node tests/render.mjs",
    "test:cpp-wasm": "CPP_REAL=wasm ONLY_COURSE=cpp-pro node tests/run.mjs",
    "ux-audit": "node tools/ux-audit.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@live-codes/java-wasm": "0.1.0",
    "@php-wasm/node": "^3.1.64",
    "@php-wasm/node-8-3": "^3.1.64",
    "@php-wasm/universal": "^3.1.64",
    "@php-wasm/web": "^3.1.64",
    "@php-wasm/web-8-3": "^3.1.64",
    "codemirror": "^6.0.2",
    "JSCPP": "^2.0.9",
    "pyodide": "^314.0.7",
    "sql.js": "^1.16.0"
  },
  "engines": {
    "node": ">=18"
  }
}
